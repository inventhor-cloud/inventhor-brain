{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INVENTHOR Shared Organizer Project Work Capsule (read-only export)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "task_id",
    "source_revision",
    "architecture_snapshot_ref",
    "objective",
    "scope_keys",
    "owner_agent_id",
    "role",
    "state",
    "next_action",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "architecture_snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "constitution_version": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "target_outcome": {
      "type": "string"
    },
    "architecture_adrs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "module_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "PLANNER",
        "IMPLEMENTER",
        "REVIEWER",
        "TESTER",
        "INTEGRATOR",
        "OPERATOR"
      ]
    },
    "state": {
      "type": "string"
    },
    "lease_ref": {
      "type": "string"
    },
    "checkpoint_ref": {
      "type": "string"
    },
    "handoff_ref": {
      "type": "string"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "do_not_repeat": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_required_by": {
      "type": "string"
    },
    "quality_gate_ref": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
