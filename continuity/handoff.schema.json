{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INVENTHOR Provider Handoff",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "project_id",
    "created_at",
    "current_state",
    "next_task"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "handoff_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "from_agent": {
      "type": "string"
    },
    "from_provider": {
      "type": "string"
    },
    "current_state": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_task": {
      "type": "string"
    },
    "do_not_repeat": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_revision": {
      "type": "string"
    },
    "architecture_snapshot_ref": {
      "type": "string"
    },
    "constitution_version": {
      "type": "string"
    },
    "owner_agent_id": {
      "type": "string"
    },
    "owner_lease_ref": {
      "type": "string"
    },
    "source_branch": {
      "type": "string"
    },
    "checkpoint_ref": {
      "type": "string"
    },
    "module_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "next_agent_role": {
      "type": "string",
      "enum": [
        "PLANNER",
        "IMPLEMENTER",
        "REVIEWER",
        "TESTER",
        "INTEGRATOR",
        "OPERATOR"
      ]
    },
    "review_required_by": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_gate_ref": {
      "type": "string"
    },
    "evidence_level": {
      "type": "string"
    }
  }
}
