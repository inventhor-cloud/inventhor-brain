{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INVENTHOR Provider Handoff",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "project_id",
    "created_at",
    "current_state",
    "next_task"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "handoff_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "from_agent": {
      "type": "string"
    },
    "from_provider": {
      "type": "string"
    },
    "current_state": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_task": {
      "type": "string"
    },
    "do_not_repeat": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
